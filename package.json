{
  "name": "drobek-module-counter",
  "version": "0.1.1",
  "description": "A drobek platform module: named counters per app (page views, likes, downloads) — POST /__drobek/v1/counter/:key/hit, drobek.counter.hit(key) / get(key) / list().",
  "license": "AGPL-3.0-only",
  "author": "Tomáš Grasl",
  "type": "module",
  "homepage": "https://github.com/freema/drobek-module-counter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freema/drobek-module-counter.git"
  },
  "bugs": {
    "url": "https://github.com/freema/drobek-module-counter/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "SKILL.md"
  ],
  "keywords": [
    "drobek",
    "drobek-module",
    "counter",
    "page-views"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "vitest run src/skill.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@drobek/modules": ">=0.2.0",
    "drizzle-orm": ">=0.45.0"
  },
  "devDependencies": {
    "@drobek/modules": "npm:@freema/drobek-modules@^0.7.0",
    "@drobek/sdk": "npm:@freema/drobek-sdk@^0.7.0",
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22",
    "drizzle-orm": "^0.45.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
